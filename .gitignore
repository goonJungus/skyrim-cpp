# Build products — regenerate with CMake, never commit.
build/
build-*/
out/
cmake-build-*/
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Python bytecode (fixture generators)
__pycache__/
*.pyc

# Editor / OS noise
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Runtime output
*.log
*.bmp

# ---------------------------------------------------------------------------
# Game data — nothing derived from a Bethesda installation is committed here.
#
# You regenerate any real archives/meshes from your own copy of Skyrim; they
# stay on your disk and never enter git history. The synthetic fixtures under
# tests/data/ are generated by this repository's own scripts (tests/make_*.py)
# and are intentionally tracked so `ctest` runs with no game install present.
# ---------------------------------------------------------------------------

# Keep the synthetic fixtures despite the game-data extensions above.
!tests/data/**
