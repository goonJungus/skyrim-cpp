# Normalise text to LF in the repository; leave binaries untouched.
* text=auto

# Synthetic test fixtures are binary — never diff or convert them.
*.bsa     binary
*.esm     binary
*.esp     binary
*.raw     binary
*.z       binary
*.STRINGS binary
*.bmp     binary

# Windows build scripts, if any, keep CRLF.
*.bat     text eol=crlf
*.ps1     text eol=crlf
